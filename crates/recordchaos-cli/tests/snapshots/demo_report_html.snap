<div class="dl added"><span>17</span><span>+</span><span class="t">      &quot;fullUrl&quot;: &quot;urn:uuid:d1083aff-f2a0-4867-8be2-c7f38659e900&quot;,</span></div>
<div class="dl context"><span>18</span><span></span><span class="t">      &quot;resource&quot;: {</span></div>
<div class="dl context"><span>19</span><span></span><span class="t">        &quot;resourceType&quot;: &quot;Patient&quot;,</span></div>
