<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>recordchaos third-party licences</title>
<style>
:root{--ink:#0b1220;--muted:#4a5565;--rule:#e3e6eb;--surface:#f6f7f9;--ground:#ffffff;--blue:#0065FD;color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--ink:#e3e6eb;--muted:#a3adbb;--rule:#263044;--surface:#121a2b;--ground:#0b1220;--blue:#5b9bff;color-scheme:dark}}
:root[data-theme="dark"]{--ink:#e3e6eb;--muted:#a3adbb;--rule:#263044;--surface:#121a2b;--ground:#0b1220;--blue:#5b9bff;color-scheme:dark}
body{margin:0;padding:32px 16px;background:var(--ground);color:var(--ink);font:15px/1.5 ui-sans-serif,system-ui,sans-serif}
main{max-width:960px;margin:0 auto}
h1{font-size:24px;margin:0 0 8px}h2{font-size:18px;margin:32px 0 8px}
p,li{color:var(--muted)}a{color:var(--blue)}
ul.used{margin:0 0 12px;padding-left:20px}
pre{margin:0;padding:12px 16px;background:var(--surface);border:1px solid var(--rule);border-radius:4px;font:12px/1.5 ui-monospace,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere}
</style>
</head>
<body>
<main>
<h1>Third-Party Licences</h1>
<p>The recordchaos binaries include these open-source crates. Each licence below is listed once, with the crates that use it.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<ul class="used">
{{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</main>
</body>
</html>
